# Groq API
GROQ_API_KEY=gsk_your_groq_api_key_here

# LLM Configuration
LLM_MODEL=qwen/qwen3.8-27b

# Databases
CHECKPOINT_DB=checkpoints.db
TTL_DB=ttl.db

# TTL Configuration (in seconds)
DEFAULT_TTL_SECONDS=3600
SWEEPER_INTERVAL_SECONDS=60

# Server
HOST=0.0.0.0
PORT=8000

# SMTP (optional — send_email runs in dry-run mode if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Agent sandbox database (for modify_database tool)
AGENT_SANDBOX_DB=agent_sandbox.db
